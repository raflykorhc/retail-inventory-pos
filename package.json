{
  "name": "retail-inventory-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run tunnel:named\"",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "preview": "vite preview",
    "test": "NODE_ENV=test jest",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "tunnel": "cloudflared tunnel --url http://localhost:3002",
    "tunnel:named": "cloudflared tunnel --no-autoupdate run --token $TUNNEL_TOKEN"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.3.0",
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.99.2",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.1",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esc-pos-encoder": "^3.0.0",
    "express": "^4.22.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "react-to-print": "^3.3.0",
    "react-virtuoso": "^4.7.11",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.9",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
