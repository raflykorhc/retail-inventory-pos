generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  products  Product[]
}

model Unit {
  id            String            @id @default(cuid())
  name          String            @unique
  deletedAt     DateTime?
  productPrices ProductPrice[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockBatches  StockBatch[]
  batchPrices   StockBatchPrice[]
}

model Product {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  categoryId  String
  stock       Float     @default(0)
  minStock    Float     @default(10)
  averageCost Decimal   @default(0)
  deletedAt   DateTime?
  supplierId  String?

  abcCategory  String? 
  leadTime     Int     @default(3) 
  holdingInterval Int?
  maxStock     Float? 
  suggestedMin Float? 
  suggestedMax Float? 
  warehouseCapacity Float?
  safetyStockDays Int @default(1)

  cartItems     CartItem[]
  category      Category       @relation(fields: [categoryId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  prices        ProductPrice[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockBatches  StockBatch[]
  stockLogs     StockLog[]
  productImage  ProductImage?

  @@index([categoryId])
  @@index([supplierId])
  @@index([code])
  @@index([abcCategory])
  @@index([name])
  @@index([deletedAt])
}

model ProductPrice {
  id               String  @id @default(cuid())
  productId        String
  unitId           String
  price            Decimal
  conversionFactor Float
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             Unit    @relation(fields: [unitId], references: [id])
}

model StockLog {
  id           String   @id @default(cuid())
  productId    String
  type         String
  quantity     Float
  unitName     String?
  unitQuantity Float?
  reason       String?
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Sale {
  id                 String     @id @default(cuid())
  invoiceNumber      String     @unique
  totalAmount        Decimal
  paymentStatus      String
  paymentMethod      String     @default("CASH")
  amountPaid         Decimal?
  changeAmount       Decimal?
  createdAt          DateTime   @default(now())
  deletedAt          DateTime?
  userId             String?
  user               User?      @relation(fields: [userId], references: [id])
  items              SaleItem[]

  @@index([userId])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([deletedAt])
}

model SaleItem {
  id                String          @id @default(cuid())
  saleId            String
  productId         String
  unitId            String
  quantity          Float
  priceAtSale       Decimal
  isManualPrice     Boolean         @default(false)
  isBonus           Boolean         @default(false)
  conversionFactor  Float           @default(1)
  product           Product         @relation(fields: [productId], references: [id])
  sale              Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  unit              Unit            @relation(fields: [unitId], references: [id])
  batchAllocations  SaleItemBatch[]
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  unitId        String?
  batchId       String? 
  price         Decimal? 
  discount      Decimal? @default(0) 
  quantity      Float
  takenQuantity Float?
  isBonus       Boolean  @default(false)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
}

model User {
  id        String      @id @default(cuid())
  username  String      @unique
  password  String
  fullName  String
  role      String      @default("CASHIER")
  isActive  Boolean     @default(true)
  lastLogin DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  auditLogs AuditLogs[]
  salesMade Sale[]
}

model AuditLogs {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  address   String?
  email     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]

  @@index([name])
}

model Purchase {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  supplierId    String
  totalAmount   Decimal
  paymentStatus String
  paymentMethod String         @default("TRANSFER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([invoiceNumber])
}

model PurchaseItem {
  id         String      @id @default(cuid())
  purchaseId String
  productId  String
  unitId     String
  quantity   Float
  costPrice  Decimal
  product    Product     @relation(fields: [productId], references: [id])
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id])
  stockBatch StockBatch?
}

model StockBatch {
  id               String            @id @default(cuid())
  productId        String
  purchaseItemId   String?           @unique
  initialQuantity  Float
  currentQuantity  Float
  costPrice        Decimal
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sellingPrice     Decimal           @default(0)
  isArchived       Boolean           @default(false)
  saleAllocations  SaleItemBatch[]
  batchPrices      StockBatchPrice[]
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem?     @relation(fields: [purchaseItemId], references: [id])
  unit             Unit?             @relation(fields: [unitId], references: [id])
  unitId           String?
  conversionFactor Float             @default(1)

  @@index([productId])
  @@index([createdAt])
  @@index([currentQuantity])
  @@index([isArchived])
}

model StockBatchPrice {
  id      String     @id @default(cuid())
  batchId String
  unitId  String
  price   Decimal
  batch   StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  unit    Unit       @relation(fields: [unitId], references: [id])

  @@unique([batchId, unitId])
  @@index([batchId])
}

model SaleItemBatch {
  id         String     @id @default(cuid())
  saleItemId String
  batchId    String
  quantity   Float
  costPrice  Decimal
  batch      StockBatch @relation(fields: [batchId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([batchId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
}
