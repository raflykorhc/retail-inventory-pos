generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  products  Product[]
}

model Unit {
  id            String            @id @default(cuid())
  name          String            @unique
  deletedAt     DateTime?
  productPrices ProductPrice[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockBatches  StockBatch[]
  batchPrices   StockBatchPrice[]
}

model Product {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  categoryId  String
  stock       Float     @default(0)
  minStock    Float     @default(10)
  averageCost Decimal   @default(0)
  deletedAt   DateTime?
  supplierId  String?

  // --- ABC Classification & Min-Max Dynamic Stock Fields ---
  abcCategory  String? // Klasifikasi ABC: 'A', 'B', atau 'C' (null = belum diklasifikasi)
  leadTime     Int     @default(3) // Estimasi waktu tunggu supplier dalam hari (input manual pemilik)
  maxStock     Float? // Batas maksimum stok yang diinginkan
  suggestedMin Float? // Rekomendasi Min dari kalkulasi Peak Demand (cache)
  suggestedMax Float? // Rekomendasi Max dari kalkulasi Peak Demand (cache)
  // ---------------------------------------------------------

  cartItems     CartItem[]
  deliveryItems DeliveryItem[]
  category      Category       @relation(fields: [categoryId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  prices        ProductPrice[]
  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]
  saleItems     SaleItem[]
  stockBatches  StockBatch[]
  stockLogs     StockLog[]
  productImage  ProductImage?

  @@index([categoryId])
  @@index([supplierId])
  @@index([code])
  @@index([abcCategory])
  @@index([name])
  @@index([deletedAt])
}

model ProductPrice {
  id               String  @id @default(cuid())
  productId        String
  unitId           String
  price            Decimal
  conversionFactor Float
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             Unit    @relation(fields: [unitId], references: [id])
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Float
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id           String     @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  isContractor Boolean    @default(false)
  creditLimit  Decimal?
  billingDate  Int?
  tier         String     @default("REGULAR")
  notes        String?
  deletedAt    DateTime?
  debts        Debt[]
  deliveries   Delivery[]
  projects     Project[]
  returns      Return[]
  sales        Sale[]

  @@index([name])
  @@index([deletedAt])
}

model Project {
  id              String   @id @default(cuid())
  customerId      String
  projectName     String
  location        String?
  status          String   @default("ACTIVE")
  budget          Decimal  @default(0)
  specialDiscount Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])
  sales           Sale[]
}

model Sale {
  id                 String     @id @default(cuid())
  invoiceNumber      String     @unique
  customerId         String?
  projectId          String?
  totalAmount        Decimal
  paymentStatus      String
  paymentMethod      String     @default("CASH")
  amountPaid         Decimal?
  changeAmount       Decimal?
  createdAt          DateTime   @default(now())
  deletedAt          DateTime?
  userId             String?
  isDeliveryRequired Boolean    @default(false)
  debts              Debt[]
  deliveries         Delivery[]
  returns            Return[]
  customer           Customer?  @relation(fields: [customerId], references: [id])
  project            Project?   @relation(fields: [projectId], references: [id])
  user               User?      @relation(fields: [userId], references: [id])
  items              SaleItem[]

  @@index([customerId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([deletedAt])
}

model SaleItem {
  id                String          @id @default(cuid())
  saleId            String
  productId         String
  unitId            String
  quantity          Float
  deliveredQuantity Float           @default(0)
  pendingQuantity   Float           @default(0)
  priceAtSale       Decimal
  isManualPrice     Boolean         @default(false)
  isBonus           Boolean         @default(false)
  product           Product         @relation(fields: [productId], references: [id])
  sale              Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  unit              Unit            @relation(fields: [unitId], references: [id])
  batchAllocations  SaleItemBatch[]
}

model Debt {
  id               String        @id @default(cuid())
  saleId           String?
  customerId       String?
  amountDue        Decimal
  remainingBalance Decimal
  dueDate          DateTime
  status           String        @default("UNPAID")
  lastReminderSent DateTime?
  reference        String?
  notes            String?
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  sale             Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payments         DebtPayment[]

  @@index([customerId])
  @@index([saleId])
  @@index([status])
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  amountPaid  Decimal
  discount    Decimal? @default(0)
  paymentDate DateTime @default(now())
  method      String
  attachment  String?
  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paymentDate])
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  categoryRef ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal
  description String?
  receiptPath String?
  date        DateTime        @default(now())

  @@index([categoryId])
  @@index([date])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  expenses  Expense[]
}

model Delivery {
  id           String         @id @default(cuid())
  doNumber     String         @unique
  saleId       String?
  customerId   String?
  address      String?
  driverName   String?
  vehiclePlate String?
  status       String         @default("PENDING")
  signature    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  customer     Customer?      @relation(fields: [customerId], references: [id])
  sale         Sale?          @relation(fields: [saleId], references: [id])
  items        DeliveryItem[]
}

model DeliveryItem {
  id         String   @id @default(cuid())
  deliveryId String
  productId  String
  quantity   Float
  unitName   String
  isChecked  Boolean  @default(false)
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  saleId       String?
  customerId   String?
  reason       String?
  resolution   String       @default("REFUND")
  totalAmount  Decimal      @default(0)
  createdAt    DateTime     @default(now())
  customer     Customer?    @relation(fields: [customerId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])
  items        ReturnItem[]
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Float
  price     Decimal
  condition String  @default("GOOD")
  product   Product @relation(fields: [productId], references: [id])
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  productId     String
  unitId        String?
  batchId       String? // Untuk mendukung FIFO batch selection yang tetap persisten saat sync
  price         Decimal? // Untuk menyimpan harga saat ditambahkan ke cart agar tidak berubah-ubah atau hilang
  discount      Decimal? @default(0) // Menyimpan diskon per item
  quantity      Float
  takenQuantity Float? // Menyimpan jumlah barang yang diambil sekarang (untuk split DO/titip)
  isBonus       Boolean  @default(false)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
}

model User {
  id        String      @id @default(cuid())
  username  String      @unique
  password  String
  fullName  String
  role      String      @default("CASHIER")
  isActive  Boolean     @default(true)
  lastLogin DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  auditLogs AuditLogs[]
  salesMade Sale[]
}

model AuditLogs {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  address   String?
  email     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  payables  Payable[]
  products  Product[]
  purchases Purchase[]

  @@index([name])
}

model Purchase {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  supplierId    String
  totalAmount   Decimal
  paymentStatus String
  paymentMethod String         @default("TRANSFER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payables      Payable[]
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([invoiceNumber])
}

model PurchaseItem {
  id         String      @id @default(cuid())
  purchaseId String
  productId  String
  unitId     String
  quantity   Float
  costPrice  Decimal
  product    Product     @relation(fields: [productId], references: [id])
  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id])
  stockBatch StockBatch?
}

model Payable {
  id               String           @id @default(cuid())
  purchaseId       String?
  supplierId       String
  amountDue        Decimal
  remainingBalance Decimal
  dueDate          DateTime
  status           String           @default("UNPAID")
  reference        String?
  notes            String?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  purchase         Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  payments         PayablePayment[]

  @@index([supplierId])
  @@index([purchaseId])
  @@index([status])
}

model PayablePayment {
  id          String   @id @default(cuid())
  payableId   String
  amountPaid  Decimal
  discount    Decimal? @default(0)
  paymentDate DateTime @default(now())
  method      String
  attachment  String?
  payable     Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([paymentDate])
  @@index([payableId])
}

model StockBatch {
  id               String            @id @default(cuid())
  productId        String
  purchaseItemId   String?           @unique
  initialQuantity  Float
  currentQuantity  Float
  costPrice        Decimal
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sellingPrice     Decimal           @default(0)
  isArchived       Boolean           @default(false)
  saleAllocations  SaleItemBatch[]
  batchPrices      StockBatchPrice[]
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItem     PurchaseItem?     @relation(fields: [purchaseItemId], references: [id])
  unit             Unit?             @relation(fields: [unitId], references: [id])
  unitId           String?
  conversionFactor Float             @default(1)

  @@index([productId])
  @@index([createdAt])
  @@index([currentQuantity])
  @@index([isArchived])
}

model StockBatchPrice {
  id      String     @id @default(cuid())
  batchId String
  unitId  String
  price   Decimal
  batch   StockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  unit    Unit       @relation(fields: [unitId], references: [id])

  @@unique([batchId, unitId])
  @@index([batchId])
}

model SaleItemBatch {
  id         String     @id @default(cuid())
  saleItemId String
  batchId    String
  quantity   Float
  costPrice  Decimal
  batch      StockBatch @relation(fields: [batchId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([batchId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes    // raw binary image data
  mimeType  String   // e.g. "image/jpeg"
}
